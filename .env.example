# Public application configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
APP_URL=https://www.riink.app

# Server-only configuration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAILS=owner@example.com
CRON_SECRET=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
NUMBER_SELECTION_SIGNING_KEY=replace-with-32-byte-base64-key

# Background jobs (the Vercel integration can set both automatically)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# SMS provider (server-only; never expose these variables to the client)
TWILIO_ACCOUNT_SID=your-account-id
TWILIO_AUTH_TOKEN=your-auth-token

# Billing provider (server-only)
STRIPE_SECRET_KEY=your-secret-key
STRIPE_PUBLISHABLE_KEY=your-publishable-key
STRIPE_WEBHOOK_SECRET=your-webhook-secret
STRIPE_BASE_PRICE_ID=your-monthly-price-id

# Transactional email (server-only)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=Riink <support@riink.app>
DEMO_REQUEST_TO_EMAIL=tychique@verytis.com
RESEND_WEBHOOK_SECRET=whsec_your-webhook-secret
RESEND_FORWARD_FROM_EMAIL=Riink Support <support@riink.app>
SUPPORT_FORWARD_TO_EMAIL=tychique@verytis.com

# Error monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional: required only for source map uploads during deployment
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
